# Neon PostgreSQL connection string. Enable TLS with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_TTL_SECONDS=3600
EMAIL_TOKEN_TTL_SECONDS=86400
RESET_TOKEN_TTL_SECONDS=900

# Comma-separated exact HTTPS origins; never use *.
ALLOWED_ORIGINS=https://your-web-app.example

# Make.com email delivery. Keep both values in Render secrets only.
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/REPLACE_WITH_WEBHOOK_ID
MAKE_API_KEY=REPLACE_WITH_MAKE_API_KEY
PUBLIC_API_URL=https://kalkulacka-eliquidu-api.onrender.com
